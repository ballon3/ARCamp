---
import TextSlider from "../components/TextSlider.astro";
import Separator from "../components/Separator.astro";
import Search from "../components/Search.astro";
import type { CollectionEntry } from "astro:content";

type Props = {
  artistsTotal: number;
  artists: CollectionEntry<"artists">[];
};

const { artistsTotal, artists } = Astro.props;
const stages = [
  ...new Set(
    artists.flatMap((artist) =>
      artist.data.stages.length > 0
        ? artist.data.stages
        : artist.data.performances.map((p) => p.stage),
    ),
  ),
].sort((a, b) => a.localeCompare(b));
---

<header class="title-header title-header--initial">
  <h2>
    <button data-stage-reset class="stage-reset" aria-label="Show all stages">
      <TextSlider content="Artists" />
    </button>
  </h2>
  <div>
    {
      stages.map((stage) => (
        <button data-stage-filter={stage} class="stage-filter">
          <TextSlider content={stage} />
        </button>
      ))
    }
  </div>
  <span><TextSlider content={artistsTotal} /></span>
</header>

<Separator />
<Search />

<style>
  div {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    align-items: center;
    gap: 1rem;
    margin: 0;
    padding: 0;
  }
  .stage-reset {
    font-size: inherit;
    font-weight: inherit;
  }
</style>
<script src="../scripts/gridActions.js"></script>
