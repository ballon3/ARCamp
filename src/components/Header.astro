---
import TextSlider from "../components/TextSlider.astro";
import Separator from "../components/Separator.astro";
import Cross from "../assets/images/cross.svg";

// Get the current pathname
const currentPath = Astro.url.pathname;
// Define a map of routes
const routes = {
  "/": "Home",
  "/releases/": "Releases",
  "/store/": "Store",
  "/history/": "History",
  "/contact/": "Contact",
};
// Determine the active route
const activeRoute = routes[currentPath] || null;
---

<header>
  <h1>
    <a href="/" class={activeRoute === "Home" ? "current" : ""}
      ><TextSlider content="L⚡B2k26" /></a>
  </h1>
  <span><TextSlider content="" /></span>
  {
    activeRoute === "Home" && (
      <div class="search-controls">
        <button data-search class="search"><TextSlider content="Search" /></button>
        <button data-clear class="clear hidden" aria-label="Clear search">
          <Cross width={14} height={14} />
        </button>
      </div>
    )
  }
</header>
<Separator />

<style>
  header {
    position: relative;
    display: grid;
    grid-template-columns: min-content minmax(0, 1fr) auto;
    align-items: center;
    font-weight: 700;
    padding: 1rem 0;
    gap: 0.75rem;
  }
  header a.current {
    pointer-events: none;
  }
  h1 {
    font-size: 1rem;
    font-weight: inherit;
    margin: 0;
  }
  span {
    min-width: 0;
  }
  .search-controls {
    position: relative;
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.75rem;
    min-width: 0;
  }
  .search-controls:has(> .search--active)::before {
    pointer-events: none;
    content: "";
    position: absolute;
    left: -0.7rem;
    right: -0.7rem;
    top: -0.45rem;
    bottom: -0.45rem;
    border: 1px solid;
    border-radius: 2rem;
  }
  .search--active:focus-visible {
    color: inherit;
  }
  @media screen and (min-width: 50em) {
    header {
      grid-template-columns: 20vw 1fr auto;
      gap: 1rem;
    }
  }
</style>
